EAPI=8

CRATES="
@CRATES@
"

inherit cargo desktop xdg

DESCRIPTION="Roblox bootstrapper that runs the macOS client on Linux"
HOMEPAGE="https://github.com/QuadraHQ/Quadra"
SRC_URI="
	https://github.com/QuadraHQ/Quadra/archive/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="GPL-3"
SLOT="0"
KEYWORDS="~amd64"

DEPEND="
	gui-libs/gtk
	gui-libs/libadwaita
"
RDEPEND="${DEPEND}"
BDEPEND="
	llvm-core/clang
	llvm-core/lld
"

QA_FLAGS_IGNORED=".*"

src_install() {
	cargo_src_install
	domenu data/org.quadrahq.Quadra.desktop
	insinto /usr/share
	doins -r data/icons
}
